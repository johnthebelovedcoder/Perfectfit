# Prisma reads these directly (schema.prisma uses url + directUrl).
# Local Postgres: both point at the same local DB.
# Neon: DATABASE_URL = pooled (-pooler host, ?sslmode=require&pgbouncer=true), DIRECT_URL = direct host.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/Perfectfit"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/Perfectfit"
