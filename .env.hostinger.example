# Copy to `.env` next to docker-compose.yml on the Hostinger server, fill in real
# values, then: docker compose up -d
# DO NOT commit the filled-in .env — it contains live secrets.

# ── Database ──────────────────────────────────────────────────────────────────
# Leave BOTH unset to use the bundled `postgres` container (data lives in a
# Docker volume, starts empty). To use Neon (recommended — keeps your synced
# data + admin login), set both to your Neon URLs:
#   DATABASE_URL = pooled url  (host has -pooler)  + ?sslmode=require&pgbouncer=true
#   DIRECT_URL   = direct url   (no -pooler)        + ?sslmode=require
DATABASE_URL=
DIRECT_URL=

# If using the bundled postgres and you want non-default creds:
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=perfectfit

# ── Redis (bundled) ───────────────────────────────────────────────────────────
# REDIS_URL=redis://redis:6379

# ── Auth / crypto (generate: openssl rand -base64 48 / openssl rand -hex 32) ──
JWT_SECRET=
JWT_REFRESH_SECRET=
FIELD_ENCRYPTION_KEY=

# ── Payments (Stripe) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_dummy

# ── Images (Cloudinary) ───────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=ml_default

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
# RESEND_FROM="Perfect Fit <noreply@yourdomain.com>"

# ── Business / warehouse ──────────────────────────────────────────────────────
THREAD_WAREHOUSE_ADDRESS=1 Warehouse Way, Tulsa, Oklahoma
THREAD_WAREHOUSE_CONTACT_NUMBER=+1 (973) 282-6945

# ── Public origins (CORS + email links) — your real domains ───────────────────
NEXT_PUBLIC_STOREFRONT_URL=https://your-storefront-domain
NEXT_PUBLIC_SELLER_URL=https://your-seller-domain
NEXT_PUBLIC_ADMIN_URL=https://your-admin-domain
