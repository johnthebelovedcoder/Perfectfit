{
  "name": "thread",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "turbo run db:generate --filter=@thread/database",
    "db:migrate": "turbo run db:migrate --filter=@thread/database",
    "db:studio": "turbo run db:studio --filter=@thread/database"
  },
  "devDependencies": {
    "prettier": "^3.4.0",
    "tsup": "^8.5.1",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "tailwindcss-animate": "^1.0.7"
  }
}
