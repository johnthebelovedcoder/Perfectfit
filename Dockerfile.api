# API production image for a pnpm monorepo
FROM node:20-alpine3.18 AS deps
WORKDIR /app
# openssl + libc6-compat are required by the Prisma query engine on Alpine (musl)
RUN apk add --no-cache openssl libc6-compat
# Install pnpm via npm — corepack on this base image ships outdated signing
# keys and fails with "Cannot find matching keyid".
RUN npm install -g pnpm@10.33.0
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json ./
COPY packages packages
COPY apps apps
RUN pnpm install --frozen-lockfile

FROM deps AS build
WORKDIR /app
RUN pnpm --filter @thread/database exec prisma generate
RUN pnpm exec turbo run build --filter=@thread/api...

FROM node:20-alpine3.18 AS runtime
WORKDIR /app
# openssl + libc6-compat are required by the Prisma query engine on Alpine (musl)
RUN apk add --no-cache openssl libc6-compat
# Install pnpm via npm — corepack on this base image ships outdated signing
# keys and fails with "Cannot find matching keyid".
RUN npm install -g pnpm@10.33.0
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/apps/api/package.json ./apps/api/package.json
# App-level node_modules holds the API's runtime deps (reflect-metadata, nest…)
# via pnpm symlinks; without it node exits with MODULE_NOT_FOUND.
COPY --from=build /app/apps/api/node_modules ./apps/api/node_modules
# pnpm-workspace.yaml lets `pnpm --filter @thread/database` resolve at runtime
# (needed for `prisma db push`), otherwise "No projects matched the filters".
COPY --from=build /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
# Prisma schema lives in packages/database/prisma (copied below via /packages),
# so `prisma db push` / generate resolve it there — no apps/api/prisma exists.
COPY --from=build /app/packages ./packages
COPY --from=build /app/package.json ./package.json
EXPOSE 3001
WORKDIR /app/apps/api
CMD ["node", "dist/main"]