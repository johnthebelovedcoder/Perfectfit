# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/thread

# ─── Redis (Upstash) ────────────────────────────────────────────────────────
REDIS_URL=rediss://default:password@host:6379

# ─── Auth ───────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=change-me-32-char-min

# ─── Payments ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_SECRET_KEY=sk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx

# ─── Cloudinary ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=xxx
CLOUDINARY_API_SECRET=xxx
CLOUDINARY_UPLOAD_PRESET=thread_uploads

# ─── Algolia ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_ALGOLIA_APP_ID=xxx
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=xxx
ALGOLIA_ADMIN_KEY=xxx
ALGOLIA_INDEX_NAME=thread_items

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxx

# ─── Monitoring ─────────────────────────────────────────────────────────────
SENTRY_DSN=https://xxx@sentry.io/xxx
AXIOM_DATASET=thread
AXIOM_TOKEN=xxx

# ─── App URLs ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
NEXT_PUBLIC_SELLER_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_URL=http://localhost:3003

# ─── Thread Operations ───────────────────────────────────────────────────────
THREAD_WAREHOUSE_ADDRESS=123 Thread Street, New York, NY 10001
THREAD_WAREHOUSE_CONTACT_NUMBER=+1-xxx-xxx-xxxx
