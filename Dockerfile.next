# Generic Next.js production image for apps in the monorepo
FROM node:20-alpine3.18 AS deps
WORKDIR /app
# Install pnpm via npm — corepack on this base image ships outdated signing
# keys and fails with "Cannot find matching keyid".
RUN npm install -g pnpm@10.33.0
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json ./
COPY packages packages
COPY apps apps
RUN pnpm install --frozen-lockfile

FROM deps AS build
WORKDIR /app
# ARGs must be (re)declared inside the stage that uses them, otherwise they are
# empty here and NEXT_PUBLIC_* get baked into the client bundle as blank strings.
ARG PACKAGE_NAME=@thread/storefront
ARG NEXT_PUBLIC_API_URL=http://api:3001
ARG NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=replace-me
ARG NEXT_PUBLIC_SELLER_URL=http://localhost:3002
ARG NEXT_PUBLIC_ADMIN_URL=http://localhost:3003
ARG NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=${NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME}
ENV NEXT_PUBLIC_SELLER_URL=${NEXT_PUBLIC_SELLER_URL}
ENV NEXT_PUBLIC_ADMIN_URL=${NEXT_PUBLIC_ADMIN_URL}
ENV NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=${NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY}
RUN pnpm exec turbo run build --filter=${PACKAGE_NAME}...

FROM node:20-alpine3.18 AS runtime
WORKDIR /app
# Runtime runs `next start` directly (node_modules copied below) — no pnpm needed.
ARG APP_DIR=storefront
ARG NEXT_PUBLIC_API_URL=http://api:3001
ARG NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=replace-me
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=${NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME}
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/${APP_DIR}/.next ./apps/${APP_DIR}/.next
COPY --from=build /app/apps/${APP_DIR}/public ./apps/${APP_DIR}/public
COPY --from=build /app/apps/${APP_DIR}/package.json ./apps/${APP_DIR}/package.json
# App-level node_modules holds the `next` binary + pnpm symlinks; without it the
# container exits 127 (next: not found).
COPY --from=build /app/apps/${APP_DIR}/node_modules ./apps/${APP_DIR}/node_modules
COPY --from=build /app/packages ./packages
COPY --from=build /app/package.json ./package.json
WORKDIR /app/apps/${APP_DIR}
EXPOSE 3000
ENV PORT=3000
# Resolve `next` from the workspace (root or app bin) rather than a fixed path.
CMD ["sh", "-c", "./node_modules/.bin/next start -p ${PORT} || ../../node_modules/.bin/next start -p ${PORT}"]